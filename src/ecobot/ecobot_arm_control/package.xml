<?xml version="1.0"?>
<package format="3">
  <name>ecobot_arm_control</name>
  <version>0.1.0</version>
  <description>Robot arm controller for ecobot — PCA9685 I2C servo driver, kinematics, autonomous scanning</description>
  <maintainer email="user@ecobot.local">ecobot</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
