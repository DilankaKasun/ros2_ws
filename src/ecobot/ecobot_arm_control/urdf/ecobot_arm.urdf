<?xml version="1.0" ?>
<robot name="ecobot_arm">
  <link name="arm_base_link">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.04"/>
      </geometry>
      <material name="dark">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
  </link>

  <joint name="arm_base_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.8397" effort="30" velocity="1.17"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="arm_shoulder_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.1817" effort="30" velocity="1.17"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>
  </link>

  <joint name="arm_elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.1416" effort="12" velocity="1.17"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry>
        <cylinder radius="0.018" length="0.13"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.7 0.4 1"/>
      </material>
    </visual>
  </link>

  <joint name="arm_wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.1416" effort="20" velocity="1.17"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.14"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
  </link>

  <link name="camera_frame"/>
  <joint name="arm_camera_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="camera_frame"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>

</robot>
