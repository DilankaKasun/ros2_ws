#!/usr/bin/env python3
"""Standalone executable launcher for EcoBot Hardware Check."""
import os
import sys

# Ensure ecobot_bringup package is in python path
ws_root = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
if ws_root not in sys.path:
    sys.path.insert(0, ws_root)

from ecobot_bringup.hardware_check import main

if __name__ == '__main__':
    sys.exit(main())
