# Copy to .env and fill in a real value. plant_mission_node.py and
# gemini_client.py call load_dotenv(find_dotenv(usecwd=True)) at import
# time — same reasoning as ecobot_voice/.env.example: colcon COPIES (does
# not symlink) this package into install/, so cwd-based .env discovery
# requires `ros2 run` to be launched with this directory
# (src/ecobot/ecobot_mission) as the working directory.
#
# IMPORTANT: the default `ros2 launch ecobot_bringup ecobot.launch.py`
# path does not `cd` anywhere, so for that launch path GOOGLE_API_KEY must
# instead be exported in the parent shell environment before launching —
# .env discovery only works for the `cd src/ecobot/ecobot_mission && ros2
# run ecobot_mission plant_mission_node` workflow.

GOOGLE_API_KEY=

# Package-scoped model choice, deliberately independent of ecobot_voice's
# ECOBOT_GEMINI_MODEL (that one picks a chat model; this is a multi-image
# structured-vision call).
ECOBOT_MISSION_GEMINI_MODEL=gemini-3.1-flash-live-preview
