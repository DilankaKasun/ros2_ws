<?xml version="1.0"?>
<package format="3">
  <name>ecobot_mission</name>
  <version>0.1.0</version>
  <description>Autonomous per-plant mission orchestration: navigate to a standoff pose, run the arm's scan sequence, capture wrist-camera images, assess plant health via Gemini, auto-advance to the next plant</description>
  <maintainer email="user@ecobot.local">ecobot</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-cv-bridge</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
