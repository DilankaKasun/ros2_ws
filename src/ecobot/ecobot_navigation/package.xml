<?xml version="1.0"?>
<package format="3">
  <name>ecobot_navigation</name>
  <version>0.1.0</version>
  <description>Navigation stack integration for ecobot — Nav2, SLAM, waypoint following</description>
  <maintainer email="user@ecobot.local">ecobot</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
