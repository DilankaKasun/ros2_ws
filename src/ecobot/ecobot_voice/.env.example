# Copy to .env and fill in real values. Neither voice_agent.py nor
# livekit_robot_client.py rely on the LiveKit CLI to auto-load this file —
# confirmed live that the installed livekit-agents (1.6.7) never touches
# dotenv at all. Both entry points call
# load_dotenv(find_dotenv(usecwd=True)) themselves at import time, which
# requires running `ros2 run` with this directory (src/ecobot/ecobot_voice)
# as the working directory — usecwd=True is required because colcon copies
# (not symlinks) these files into install/, far from this .env.

LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- livekit_robot_client only: the ROS2-side robot participant (no
# STT/LLM/TTS — see livekit_robot_client.py's module docstring). Connects
# to this fixed, well-known room at startup; a separately-hosted
# conversational agent or human operator joins the same room to control
# the robot / see the wrist camera. ---
ECOBOT_LIVEKIT_ROOM=ecobot-control
ECOBOT_LIVEKIT_VIDEO_FPS=10

# --- LLM: Gemma via LiveKit Inference (default, LLM_BACKEND=inference) ---
# Confirmed against docs.livekit.io/agents/start/voice-ai/ — billed through
# LIVEKIT_API_KEY/SECRET above, no separate key needed for this path.
LLM_BACKEND=inference
LLM_MODEL=google/gemma-4-31b-it
# LLM_BACKEND=google fallback (direct Gemini API) needs this instead:
GOOGLE_API_KEY=

# --- STT: local, STT_MODEL selects the engine (see local_engines.py) ---
# A HF repo id (contains "/") loads via transformers — e.g. the default
# below, a Sinhala Whisper fine-tune confirmed as a standard transformers
# checkpoint on its model card. A bare size like "small"/"base" instead
# uses faster-whisper (faster, but only for stock Whisper).
STT_MODEL=seniruk/whisper-small-si
ECOBOT_HF_STT_DEVICE=cpu
ECOBOT_WHISPER_DEVICE=cpu
ECOBOT_WHISPER_COMPUTE_TYPE=int8

# --- TTS: Piper (default, TTS_ENGINE=piper) — verified working, but has NO
# Sinhala voice (Piper's catalog covers ~35 languages; checking
# huggingface.co/rhasspy/piper-voices/tree/main/si returns 404). If Sinhala
# speech OUTPUT is required (not just Sinhala understanding), you need
# TTS_ENGINE=omnivoice below instead — Piper can't produce it. ---
ECOBOT_PIPER_BIN=piper
ECOBOT_PIPER_MODEL=
ECOBOT_PIPER_SAMPLE_RATE=22050

# --- TTS: OmniVoice (TTS_ENGINE=omnivoice) — opt-in, UNVERIFIED end-to-end.
# Per its model card this is self-hosted only (no cloud API despite this
# project's earlier TTS_ENGINE=cloud naming) and needs a working CUDA torch.
# Voice cloning needs a reference clip + its transcript, not just text:
TTS_ENGINE=piper
TTS_MODEL=k2-fsa/OmniVoice
ECOBOT_OMNIVOICE_DEVICE=cuda:0
ECOBOT_OMNIVOICE_REF_AUDIO=
ECOBOT_OMNIVOICE_REF_TEXT=

# Jetson-only: NVIDIA's torch build (torch==...+nv24.08) needs
# libcusparseLt.so.0, which the pip-installed nvidia-cusparselt-cu12
# package provides but doesn't put on the linker path — `import torch`
# fails otherwise. voice_agent.py's _fix_jetson_torch_cusparselt() detects
# and fixes this automatically (verified working: re-execs the interpreter
# once with LD_LIBRARY_PATH corrected). No action needed here unless
# running Python directly outside voice_agent.py's entrypoint.

# --- Cloud STT/TTS fallback (only used if the backends below are set) ---
# ECOBOT_STT_BACKEND=deepgram
# ECOBOT_TTS_BACKEND=elevenlabs
DEEPGRAM_API_KEY=
# ElevenLabs — verify the exact env var name livekit-plugins-elevenlabs
# expects against its installed version's docs; ELEVEN_API_KEY is what it
# has historically used.
ELEVEN_API_KEY=

# For local testing (`ros2 run ecobot_voice voice_agent console`), always
# pass explicit device flags — PortAudio's "default"/raw hw: devices can
# fail or silently produce nothing on hardware whose native rate (this
# robot's mic is 44100/48000-only) doesn't match livekit-agents' fixed
# 24kHz capture rate. "pulse" resamples correctly; raw hw:N does not:
#   ros2 run ecobot_voice voice_agent console --input-device pulse --output-device pulse
# (irrelevant for `start`/`dev` — those get audio from the LiveKit room,
# not local devices; a separate device-bridge participant would be needed
# to route the robot's physical mic/speaker into a room for production use.)

# Optional overrides (defaults are set in voice_agent.py)
# ECOBOT_GEMINI_MODEL=gemini-3.1-flash-live-preview
# ECOBOT_DEEPGRAM_MODEL=nova-2
# ECOBOT_ELEVENLABS_VOICE_ID=
# ECOBOT_WRIST_CAMERA_TOPIC=/arm/camera/image_raw
